@code {
    [Parameter]
    public string EmailCliente { get; set; } = "";
    [Parameter]
    public string Servico { get; set; } = "";
    [Parameter]
    public string Mensaje { get; set; } = "";

    private string MensajePorHora()
    {
        int hora = DateTime.Now.Hour;
        if (hora >= 6 && hora < 12)
            return "¡Buenos días!";
        else if (hora >= 12 && hora < 18)
            return "¡Buenas tardes!";
        else
            return "¡Buenas noches!";
    }

    private async Task IrWhatsApp(MouseEventArgs e)
    {
        string mensaje = $"{MensajePorHora()} Estoy interesado en un servicio de {Servico} \n\n {Mensaje} \n\n Contacto:{EmailCliente}";
        string url = $"https://wa.me/584242653702?text={Uri.EscapeDataString(mensaje)}";

        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/home.js");
            await _module.InvokeVoidAsync("initHomeAnimations");
        }
    }
}
