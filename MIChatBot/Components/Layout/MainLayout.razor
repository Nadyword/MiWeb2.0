@inherits LayoutComponentBase

<!-- MAIN LAYOUT -->
<div class="page">
    <!-- HEADER/NAVIGATION -->
    <NavMenu />
    
    <!-- MAIN CONTENT -->
    <main>
        @Body
    </main>
   
    
</div>

<!-- Script para controles de accesibilidad -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Controles de accesibilidad
        const increaseTextBtn = document.querySelector('.accessibility-btn[aria-label="Aumentar tamaño de texto"]');
        const decreaseTextBtn = document.querySelector('.accessibility-btn[aria-label="Disminuir tamaño de texto"]');
        const contrastBtn = document.querySelector('.accessibility-btn[aria-label="Alto contraste"]');
        
        let currentFontSize = 100;
        let highContrast = false;
        
        if (increaseTextBtn) {
            increaseTextBtn.addEventListener('click', function() {
                if (currentFontSize < 150) {
                    currentFontSize += 10;
                    document.body.style.fontSize = currentFontSize + '%';
                }
            });
        }
        
        if (decreaseTextBtn) {
            decreaseTextBtn.addEventListener('click', function() {
                if (currentFontSize > 80) {
                    currentFontSize -= 10;
                    document.body.style.fontSize = currentFontSize + '%';
                }
            });
        }
        
        if (contrastBtn) {
            contrastBtn.addEventListener('click', function() {
                highContrast = !highContrast;
                
                if (highContrast) {
                    document.body.classList.add('high-contrast');
                } else {
                    document.body.classList.remove('high-contrast');
                }
            });
        }
    });
</script>

<style>
    /* Estilos para modo de alto contraste */
    .high-contrast {
        --primary-color: #0066CC;
        --secondary-color: #003366;
        --accent-color: #FF6600;
        --accent-secondary: #CC0000;
        --light-color: #FFFFFF;
        --dark-color: #000000;
        --gray-color: #333333;
        --light-gray: #DDDDDD;
        
        background-color: #000000;
        color: #FFFFFF;
    }
    
    .high-contrast .btn,
    .high-contrast .feature-card,
    .high-contrast .industry-card,
    .high-contrast .pricing-card,
    .high-contrast .faq-item,
    .high-contrast .demo-chat,
    .high-contrast .contact-form,
    .high-contrast .contact-info {
        border: 2px solid #FFFFFF;
    }
    
    .high-contrast a {
        color: #FFFF00;
        text-decoration: underline;
    }
    
    .high-contrast .btn {
        background-color: #FFFF00;
        color: #000000;
        font-weight: bold;
    }
</style>
