<div class="day-card @IsToday">
    <div class="day-name"><strong>@dayName</strong></div>
    <div class="day-number">@dayNumber</div>
    <div class="day-name">@monthName</div>
    <div class="activities-count">@activityCount actividades</div>
</div>



@code {
    [Parameter]
    public int? dayNumber { get; set; }
    [Parameter]
    public string? monthName { get; set; }
    [Parameter]
    public int activityCount { get; set; } = 0;
    [Parameter]
    public string? dayName { get; set; }
    [Parameter]
    public string IsToday { get; set; } = "";
}
