@page "/"

<div class="calendar-body">
    <div class="container-Calendar">
        <div class="header">
            <h1>📅 Calendario de citas</h1>
        </div>

        <div class="calendar-grid">

            @for (int i = 0; i < 36; i++)
            {
                DateTime fecha = DateTime.Now.AddDays(i);
                string dia = fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"));
                string mes = fecha.ToString("MMMM", new System.Globalization.CultureInfo("es-ES"));
                <CalendarGrid dayName=@dia dayNumber=fecha.Day monthName=@mes activityCount=3 IsToday=@(i == 0 ? "today" : "")/>
            }
        </div>
    </div>
</div>

